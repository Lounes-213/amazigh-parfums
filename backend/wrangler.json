{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amazigh-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "amazigh-db",
      "database_id": "72ca9dbd-cf84-4ed8-9835-b10e52349ddf"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "amazigh-bucket"
    }
  ],
  "vars": {}
}
